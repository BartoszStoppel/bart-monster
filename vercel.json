{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --cwd web --frozen-lockfile",
  "buildCommand": "bun run --cwd web build",
  "outputDirectory": "web/dist",
  "functions": { "api/index.rs": { "maxDuration": 300 } },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.bart.monster" }], "destination": "https://bart.monster/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/callback", "destination": "/api/index" },
    { "source": "/login/google", "destination": "/api/index" },
    { "source": "/logout", "destination": "/api/index" },
    { "source": "/_next/image", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
