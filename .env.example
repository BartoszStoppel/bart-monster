DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to local SQLite. Production stays on Supabase PostgreSQL.
# Configure a dedicated role/private Django schema before setting its DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/bart_monster
# For Supabase's transaction pooler on Vercel:
# DATABASE_POOL_MODE=transaction
# DATABASE_CONN_MAX_AGE=0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bart.monster
# TRUST_PROXY=true

# Existing NEXT_PUBLIC_SUPABASE_* names in .env.local also work.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# BGG_API_TOKEN=
# ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
# For the read-only migration export only; never needed by the running app.
# SUPABASE_SERVICE_ROLE_KEY=
