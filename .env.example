# PostgreSQL is required. Use an isolated local database for development.
DATABASE_URL=postgresql://bart:replace-me@127.0.0.1:5432/bart_monster
APP_ORIGIN=http://localhost:8000
PORT=8000
BIND_ADDRESS=127.0.0.1
RUST_LOG=info

# Existing Supabase project and Google provider; never expose server secrets.
# Legacy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names also work.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# BGG_API_TOKEN=
# ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6

# Production uses the existing private bart_django role/schema and Supabase
# transaction pooler (port 6543, sslmode=require) for runtime requests.
# Standalone queries use db::pool to pin prepare/bind inside an explicit transaction.
# One client connection per instance, closed after five idle seconds. The name is historical.
# Use the session pooler (5432) for explicit release migrations.
# APP_ORIGIN=https://bart.monster
# On Vercel previews omit APP_ORIGIN to use trusted VERCEL_URL automatically.
